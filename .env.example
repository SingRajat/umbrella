# ==============================================================================
# Umbrella V1 Configuration Environment Variables
# ==============================================================================

# LLM Provider Configuration (Groq API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
TEMPERATURE=0.7

# Ingestion & Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Retrieval Parameters
TOP_K=3
SIMILARITY_THRESHOLD=0.5

# Vector Store / Storage
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=umbrella_docs

# API & Security
API_HOST=127.0.0.1
API_PORT=8000
RATE_LIMIT_RPM=60
STRICT_REFUSAL=true

# Observability
LOG_LEVEL=INFO
