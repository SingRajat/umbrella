# LLM Provider (Groq API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
TEMPERATURE=0.7

# RAG Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=3
SIMILARITY_THRESHOLD=0.5

# Storage Configuration
CHROMA_PERSIST_DIR=data/chroma_db

# API & Security
MAX_UPLOAD_SIZE_MB=25
RATE_LIMIT_RPM=60
STRICT_REFUSAL=true
LOG_LEVEL=INFO
